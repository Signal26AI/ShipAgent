{
  "name": "shipagent",
  "version": "0.1.0",
  "description": "AI-powered App Store review agent — catch rejection risks before you submit",
  "type": "module",
  "bin": {
    "shipagent": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp -r src/kb dist/kb",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ios",
    "app-store",
    "review",
    "apple",
    "rejection",
    "compliance",
    "xcode"
  ],
  "author": "Signal26AI",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.81",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "peerDependencies": {
    "shiplint": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "shiplint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "shiplint": "^1.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
